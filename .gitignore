.DS_Store

# Local environment and secrets
.env
.env.*
!.env.example

# Java / Gradle build outputs
**/.gradle/
**/build/
**/bin/
**/out/

# Node / Vite build outputs
**/node_modules/
**/dist/

# Python caches
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Logs and temporary runtime files
*.log
*.pid
**/logs/

# IDE files
**/.idea/
**/.vscode/
*.iml

# Local archives and bundled infrastructure images
*.tar
*.tar.gz
*.zip
